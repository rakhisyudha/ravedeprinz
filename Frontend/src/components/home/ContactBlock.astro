---
import type { ContactView } from '../../lib/availability';
import { contactTagline, socialLinks } from '../../data/site';

interface Props {
  contact: ContactView;
}

const { contact } = Astro.props;
---

{/*
  Identity on the left, CONNECT links on the right. Reading order is wordmark,
  tagline, then the email: the name introduces the block and the mailto is the
  direct method beneath it. The block deliberately ends there: the real site
  footer follows and already closes the page, so this section carries no
  copyright line, no rule, and no status repeat of its own.

  The CV download is not here — it lives in the hero beside the primary CTA.
  Both read the same `cvUrl` field from the contact view model, so the two
  placements cannot drift apart.
*/}
<section class="home-preview contact-block-wrap" aria-labelledby="home-contact-title">
  <p class="home-preview-label" id="home-contact-title">CONTACT <span>// REACH ME</span></p>

  <div class="contact-cols">
    <div class="contact-identity">
      <a href="/" class="contact-mark" aria-label="ravedeprinz home"><strong>r</strong>avedeprinz_</a>
      <p class="contact-tagline">{contactTagline}</p>
      {contact.email && (
        <p class="contact-direct">
          <a class="contact-link" href={`mailto:${contact.email}`}>{contact.email}</a>
        </p>
      )}
      {contact.note && <p class="contact-note">{contact.note}</p>}
    </div>

    <div class="contact-connect">
      <p class="connect-label">CONNECT</p>
      {socialLinks.length > 0 && (
        <ul class="connect-list">
          {socialLinks.map((link) => (
            <li>
              <a class="connect-link" href={link.href} target="_blank" rel="noreferrer">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </div>
</section>

<style>
  .home-preview { position:relative; z-index:1; max-width:1430px; margin:44px auto 0; padding-bottom:34px; }
  .home-preview-label { display:flex; gap:14px; align-items:center; margin:0 0 18px; color:var(--text-faint); font:700 var(--type-label) var(--font-ui); letter-spacing:3px; }

  .contact-direct { margin:14px 0 0; }
  .contact-note { margin:8px 0 0; color:var(--text-muted); font:var(--type-small) var(--font-ui); overflow-wrap:anywhere; }
  .contact-link { color:var(--text); font:var(--type-body) var(--font-ui); overflow-wrap:anywhere; text-decoration:none; }
  .contact-link:hover { color:var(--red); }
  .contact-link:focus-visible { outline:2px solid var(--red); outline-offset:3px; }

  .contact-cols { display:grid; grid-template-columns:minmax(0,1fr) auto; gap:34px; align-items:start; }

  /* Wordmark hover is a true swap, not a colour wash: the "r" starts red and
     the rest light, and they trade places on hover. Every colour is a
     theme-aware token — `--paper`/`--ink` are fixed across both themes, so
     using them here rendered white-on-white in light mode. The header's
     site-mark keeps its own underline treatment and is untouched. */
  .contact-mark { display:inline-block; color:var(--text); font:700 25px var(--font-ui); letter-spacing:.02em; text-decoration:none; transition:color .18s ease; }
  .contact-mark strong { color:var(--red); font-size:34px; line-height:0; transition:color .18s ease; }
  .contact-mark:hover { color:var(--red); }
  .contact-mark:hover strong { color:var(--text); }
  .contact-mark:focus-visible { outline:2px solid var(--red); outline-offset:3px; }
  .contact-tagline { margin:10px 0 0; color:var(--text-muted); font:var(--type-body) var(--font-ui); }

  .connect-label { margin:0 0 10px; color:var(--text-faint); font:700 var(--type-label) var(--font-ui); letter-spacing:3px; }
  .connect-list { list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:7px; }
  .connect-link { color:var(--text-muted); font:700 var(--type-label) var(--font-ui); letter-spacing:2px; text-decoration:none; transition:color .18s ease; }
  .connect-link:hover { color:var(--red); }
  .connect-link:focus-visible { outline:2px solid var(--red); outline-offset:3px; }
  .contact-connect .connect-link { display:inline-block; margin-top:7px; }

  /* Below the breakpoint the two columns stack, and the block stopped reading
     as a closing section: flush left, uneven gaps, and the profile links
     trailing off as two grey lines before the footer. Centred here as one
     deliberate closing block, on an even vertical rhythm, with the profile
     link taking the shared bracket control's boxed weight — `[ GITHUB ]`,
     matching `[ ALL PROJECTS ]` — instead of plain grey text. Centring is
     safe for the wordmark: its hover is a colour swap, not a layout one, and
     the mark stays an inline-block so it centres as a unit.

     The shared bracket control is not carried in the markup because it would
     box the links in the desktop two-column layout too, where the CONNECT
     column is a quiet list; only the mobile presentation changes, so the
     treatment is declared for the mobile link rather than reused as a class.
     Desktop is untouched above this block. */
  @media (max-width: 480px) {
    .home-preview { margin-top:32px; padding-bottom:24px; text-align:center; }
    .home-preview-label { justify-content:center; }
    .contact-cols { grid-template-columns:minmax(0,1fr); gap:30px; }

    /* Even rhythm through the stacked column: wordmark → tagline → email →
       CONNECT, none of them crowding its neighbour. */
    .contact-tagline { margin-top:16px; }
    .contact-direct { margin-top:16px; }
    .contact-note { margin-top:12px; }

    /* Bracket-button treatment, matching the shared bracket box and its
       accent hover so the link carries weight instead of floating below the
       block as bare text. */
    .connect-list { gap:10px; }
    .contact-connect a { margin-top:0; border:2px solid var(--line-25); padding:9px 14px; color:var(--text); letter-spacing:2px; transition:border-color .2s ease,color .2s ease,box-shadow .2s ease,transform .2s ease; }
    .contact-connect a::before { content:'['; }
    .contact-connect a::after { content:']'; }
    .contact-connect a:hover,.contact-connect a:focus-visible { border-color:var(--red); color:var(--red); transform:translate(-2px,-2px); box-shadow:4px 4px 0 var(--dark-red); }
    .contact-connect a:focus-visible { outline:2px solid var(--red); outline-offset:3px; }
  }
</style>
