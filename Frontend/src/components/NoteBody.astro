---
import { parseBlocks } from '../lib/markdown';
import type { Block } from '../lib/markdown';
// Note: block parsing lives in lib/markdown.ts (shared with the CMS
// preview). Only the article rendering below is specific to this view.
interface Props {
  body: string;
}

const { body } = Astro.props;

const blocks: Block[] = parseBlocks(body);
---
<div class="note-article-body">
  {blocks.map((block) => {
    if (block.kind === 'list') {
      return (
        <ul>
          {block.items.map((inline, j) => (
            <li>
              {inline.map((part, k) =>
                part.kind === 'image' ? (
                  <img-${k}`} src={part.src} alt={part.alt} width={640} height={360} class="note-inline-image" loading="lazy" />
                ) : part.kind === 'strong' ? (
                  <strong>{part.text}</strong>
                ) : part.kind === 'em' ? (
                  <em>{part.text}</em>
                ) : (
                  part.text
                ),
              )}
            </li>
          ))}
        </ul>
      );
    }
    if (block.kind === 'quote') {
      return (
        <blockquote>
          {block.inlines.map((inline, j) => (
            <p>
              {inline.map((part, k) =>
                part.kind === 'image' ? (
                  <img src={part.src} alt={part.alt} width={640} height={360} class="note-inline-image" loading="lazy" />
                ) : part.kind === 'strong' ? (
                  <strong>{part.text}</strong>
                ) : part.kind === 'em' ? (
                  <em>{part.text}</em>
                ) : (
                  part.text
                ),
              )}
            </p>
          ))}
        </blockquote>
      );
    }
    if (block.kind === 'heading') {
      return (
        <div>
          <h2>
            {block.inline.map((part, k) =>
              part.kind === 'image' ? (
                <img src={part.src} alt={part.alt} width={640} height={360} class="note-inline-image" loading="lazy" />
              ) : part.kind === 'strong' ? (
                <strong>{part.text}</strong>
              ) : part.kind === 'em' ? (
                <em>{part.text}</em>
              ) : (
                part.text
              ),
            )}
          </h2>
          {block.rest.map((inline, j) => (
            <p>
              {inline.map((part, k) =>
                part.kind === 'image' ? (
                  <img-${k}`} src={part.src} alt={part.alt} width={640} height={360} class="note-inline-image" loading="lazy" />
                ) : part.kind === 'strong' ? (
                  <strong>{part.text}</strong>
                ) : part.kind === 'em' ? (
                  <em>{part.text}</em>
                ) : (
                  part.text
                ),
              )}
            </p>
          ))}
        </div>
      );
    }
    return block.inlines.map((inline, j) => (
      <p>
        {inline.map((part, k) =>
          part.kind === 'image' ? (
            <img-${k}`} src={part.src} alt={part.alt} width={640} height={360} class="note-inline-image" loading="lazy" />
          ) : part.kind === 'strong' ? (
            <strong>{part.text}</strong>
          ) : part.kind === 'em' ? (
            <em>{part.text}</em>
          ) : (
            part.text
          ),
        )}
      </p>
    ));
  })}
</div>
