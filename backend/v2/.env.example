# Copy to .env for local development. Never commit real secrets.
PORT=4100
DATABASE_URL=postgres://archive:archive@127.0.0.1:5433/ravedeprinz
FRONTEND_URL=http://localhost:3100

# Owner account provisioned by `bun src/seed-auth.ts`.
# The password is hashed with Bun.password before storage and never logged.
AUTH_SEED_EMAIL=owner@example.com
AUTH_SEED_PASSWORD=change-me-before-seeding
