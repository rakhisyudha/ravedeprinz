---
import Base from '../layouts/Base.astro';
import LoginForm from '../components/LoginForm.svelte';

export const prerender = true;

const apiBase = (
  import.meta.env.PUBLIC_CMS_API_URL ?? 'http://localhost:4100'
).replace(/\/$/, '');
---
<Base title="SIGN IN" currentPath="/login" header={false} footer={false}>
  <main class="auth-page">
    <div class="auth-home-wrap auth-home-in">
      <a href="/" class="auth-home touch-target" aria-label="Back to home"><span aria-hidden="true">←</span> HOME</a>
    </div>

    <span class="auth-backdrop auth-backdrop-in" aria-hidden="true">ARCHIVE</span>

    <div class="auth-card-enter auth-frame-in">
      <div class="auth-card">
        <div class="auth-head-in">
          <p class="eyebrow"><span class="slash">//</span> PRIVATE ARCHIVE</p>
          <h1 class="display auth-title">SIGN<br /><span>IN</span></h1>
        </div>

        <p class="auth-desc-in">Only registered accounts can access the content archive. If your email is not on the allowlist, sign-in will be rejected.</p>

        <LoginForm client:load apiBase={apiBase} />
      </div>
    </div>

    <p class="auth-meta"><strong>r</strong>avedeprinz_ <span>PERSONAL ARCHIVE</span></p>
  </main>
  <style>
    /* Staged entrance (mirrors the previous login choreography). */
    .auth-home-in { animation: auth-home-in 0.25s ease-out 0.1s both; }
    .auth-backdrop-in { animation: auth-backdrop-in 0.9s ease-out both; }
    .auth-frame-in { animation: auth-frame-in 0.4s cubic-bezier(0.22, 1, 0.36, 1) both; }
    .auth-head-in { animation: auth-head-in 0.34s cubic-bezier(0.22, 1, 0.36, 1) 0.12s both; }
    .auth-desc-in { animation: auth-rise 0.3s ease-out 0.2s both; }
    @keyframes auth-home-in { from { opacity: 0; transform: translateX(-12px); } }
    @keyframes auth-backdrop-in { from { opacity: 0; transform: translateX(60px); } }
    @keyframes auth-frame-in { from { opacity: 0; transform: translateY(24px); } }
    @keyframes auth-head-in { from { opacity: 0; transform: translateX(-24px); } }
    @keyframes auth-rise { from { opacity: 0; transform: translateY(10px); } }

    @media (prefers-reduced-motion: reduce) {
      .auth-home-in,
      .auth-backdrop-in,
      .auth-frame-in,
      .auth-head-in,
      .auth-desc-in { animation: none; }
    }
  </style>
</Base>
