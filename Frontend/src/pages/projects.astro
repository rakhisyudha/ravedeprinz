---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { fetchProjects } from '../lib/cms';
import { fallbackProjectList } from '../lib/fallback';
import { projectEntryHref, projectImage } from '../lib/projects';

export const prerender = false;

// Live projects when the CMS answers; otherwise the intentional static
// fallback, normalized to the same shape so one code path renders both.
const liveProjects = await fetchProjects();
const projects = liveProjects?.projects ?? fallbackProjectList();

const statusVariants = { FINISHED: 'finished', 'IN PROGRESS': 'in-progress', SHELVED: 'shelved' } as const;
const deploymentVariants = { DEPLOYED: 'deployed', NOT_DEPLOYED: 'not-deployed' } as const;
---
<Base title="PROJECTS" currentPath="/projects">
  <PageHead index="BUILD LOG / 004" title="PROJECTS" intro="Things made while learning how to make better software. Finished, experimental, paused, and still worth remembering.">
    <section class="record-list">
      {projects.map((project, index) => {
        // Null until the case-study pages exist, which makes the entry plain
        // non-interactive text instead of a link to a 404. It gates the title
        // link only: the card is never an anchor (see the note below), so it
        // never gets the `lift` interaction — that treatment belongs on the
        // element you can actually click.
        const href = projectEntryHref(project);
        const image = projectImage(project);
        const statusVariant = statusVariants[project.status] ?? 'shelved';
        const deploymentVariant = deploymentVariants[project.deployment_status] ?? 'not-deployed';
        const deploymentLabel = project.deployment_status === 'DEPLOYED' ? 'DEPLOYED' : 'NOT DEPLOYED';
        return (
          <article class:list={['record', 'project-record']}>
            <span class="record-number">0{index + 1}<small>{project.year}</small></span>
            <div class="project-content">
              <div class="project-media">
                <div class={`project-frame project-card-${index % 4}`}>
                  <div class="project-chrome" aria-hidden="true"><i /><i /><i /></div>
                  {image && <div class="project-image"><img src={image} alt={`${project.title} preview`} loading="lazy" /></div>}
                </div>
                <div class="project-status-badges" aria-label={`Project status: ${project.status}; ${deploymentLabel}`}>
                  <span class={`project-status-badge project-status-${statusVariant}`}>{project.status}</span>
                  <span class={`project-status-badge project-status-${deploymentVariant}`}>{deploymentLabel}</span>
                </div>
                <span class={`project-index index-slot index-style-${index % 4}`}>0{index + 1} / {project.year}</span>
              </div>
              {/* The title is only a link once the case-study pages exist; see
                  PROJECT_PAGES_PUBLISHED. The card itself is never an anchor,
                  so the external links below are never nested links. */}
              <h2>{href ? <a href={href}>{project.title}</a> : project.title}</h2>
              <p>{project.description}</p>
              <p class="metadata">{project.stack}</p>
              <div class="project-links">
                {project.live_url && <a href={project.live_url} target="_blank" rel="noreferrer">Live ↗</a>}
                {project.source_url && <a href={project.source_url} target="_blank" rel="noreferrer">Source ↗</a>}
              </div>
            </div>
            <aside><span>ARCHIVE NOTE</span><p>{project.status === 'SHELVED' ? 'Not finished. Still useful.' : 'A record of making, testing, and learning.'}</p></aside>
          </article>
        );
      })}
    </section>
  </PageHead>
</Base>
