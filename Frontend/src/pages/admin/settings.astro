---
import Admin from '../../layouts/Admin.astro';
import AdminSettings from '../../components/admin/AdminSettings.svelte';

export const prerender = false;

const apiBase = (
  import.meta.env.PUBLIC_CMS_API_URL ?? 'http://localhost:4100'
).replace(/\/$/, '');
---
<Admin title="CONTROL — CONTACT" currentPath="/admin/settings">
  <AdminSettings client:load apiBase={apiBase} />
</Admin>
