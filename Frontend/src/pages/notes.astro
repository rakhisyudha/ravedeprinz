---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { fetchNotes } from '../lib/cms';
import { fallbackNoteList } from '../lib/fallback';
import { noteDateLabel, noteSlug, readLabel } from '../lib/notesPreview';

export const prerender = false;

// Live notes when the CMS answers; otherwise the intentional static
// fallback, normalized to the same shape. The strip and this list share
// noteDateLabel/noteSlug/readLabel, so both render identical labels and
// hrefs for the same note.
const liveNotes = await fetchNotes();
const notes = liveNotes?.notes ?? fallbackNoteList();
---
<Base title="NOTES" currentPath="/notes">
  <PageHead index="TRANSMISSIONS / 005" title="NOTES" intro="Short transmissions from the workbench. Mostly unfinished thoughts, left legible on purpose.">
    <section class="notes-list">
      {notes.map((note) => {
        const slug = noteSlug(note);
        return (
          <article class="note lift">
            <a href={`/notes/${slug}`} class="note-link">
              <span class="note-date">{noteDateLabel(note.created_at, note.published_at)}<small>{readLabel(note)}</small></span>
              <div class="note-body">
                <p class="eyebrow">{note.tag}{note.author ? ` · ${note.author}` : ''}</p>
                <h2>{note.title}</h2>
                <p>{note.subtitle || note.body}</p>
              </div>
              {note.image_url && (
                <div class="note-thumb">
                  <img src={note.image_url} alt="" loading="lazy" />
                </div>
              )}
            </a>
          </article>
        );
      })}
    </section>
  </PageHead>
</Base>
