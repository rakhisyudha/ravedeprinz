---
import Base from '../layouts/Base.astro';
import HudPanel from '../components/HudPanel.svelte';
import FeaturedProjects from '../components/home/FeaturedProjects.astro';
import LatestNotes from '../components/home/LatestNotes.astro';
import NowStatusLine from '../components/home/NowStatusLine.astro';
import ContactBlock from '../components/home/ContactBlock.astro';
import { fetchHome } from '../lib/cms';
import { loadHomePreview } from '../lib/homePreview';
import { cached } from '../lib/requestCache';
import { homeContent as fallbackContent, navigation as fallbackNav } from '../data/site';

// Home is CMS-backed. Render it per request so admin edits are visible on
// the next reload without rebuilding the Astro server.
export const prerender = false;

// The preview blocks. All five CMS requests start through the request cache
// at once, so the page's total CMS wait is one timeout window; Base.astro's
// own two fetches join those in-flight promises instead of queueing behind
// them. Each block then decides independently between live and fallback
// data, and a block whose builder fails is dropped rather than failing the
// page.
const preview = await loadHomePreview(Astro.locals);

// Live home content when the CMS answers; otherwise the intentional
// static fallback below. `liveHome === null` means CMS-unreachable. The
// same cached promise Base.astro reads, so the home payload is fetched once.
const liveHome = await cached(Astro.locals, 'home', fetchHome);
const content = liveHome?.content ?? fallbackContent;
const navigation = liveHome?.navigation ?? fallbackNav;

// PROJECTS, NOTES, and NOW each have a dedicated preview section lower on
// this page (Featured Work, Latest Notes, Now), and those link to the same
// destinations, so the Archive Index only carries the two pages that do not.
// Every field still comes from the CMS — this filters rows, it does not
// hardcode any label, description, number, or href.
const ARCHIVE_INDEX_KEYS = new Set(['about', 'work']);
const archiveIndex = navigation.filter((item) => ARCHIVE_INDEX_KEYS.has(item.page_key));
---
<Base title="Rakhis de Yudha // Personal archive" currentPath="/">
  <main class="home-page">
    <div class="home-layout">
      <section class="home-copy">
        <p class="eyebrow"><span class="slash">//</span> {content.archive_label} / {content.archive_number}</p>
        <h1 class="display">{content.headline_line_one}<br /><span class="accent-word">{content.headline_line_two}</span>{content.headline_line_three}<span class="accent-dot">{content.headline_period}</span></h1>
        <div class="headline-meta"><span>{content.headline_meta}</span><i /></div>
        <p class="lede">{content.intro}</p>
        <a href={content.cta_url} class="home-cta">{content.cta_label} <b>↗</b></a>
      </section>
      <aside class="profile-column">
        <div class="hud-only">
          <HudPanel
            client:visible
            years={content.years_building}
            label={content.hud_label}
            noiseTop={content.hud_noise_top}
            noiseBottom={content.hud_noise_bottom}
          />
        </div>
        <div class="quick-links">
          {navigation.slice(-2).reverse().map((item) => (
            <a href={item.href}><span>{item.display_number}</span> {item.label.toUpperCase()}</a>
          ))}
        </div>
      </aside>
    </div>
    <nav class="home-rule" aria-label="Explore the archive">
      <p class="home-rule-label">ARCHIVE INDEX <span>// SELECT A RECORD</span></p>
      <div class="home-records">
        {archiveIndex.map((item, index) => (
          <a href={item.href} class={`home-record row-hover home-record-${index}`}>
            <span class="home-record-number">{item.display_number}</span>
            <span class="home-record-copy"><b>{item.label}</b><small>{item.description}</small></span>
            <span class="home-record-arrow row-arrow" aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </nav>
    {preview.featured && <FeaturedProjects entries={preview.featured} />}
    {preview.notes && <LatestNotes entries={preview.notes} />}
    <NowStatusLine status={preview.now} />
    <ContactBlock contact={preview.contact} />
  </main>
</Base>
