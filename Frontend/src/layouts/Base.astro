---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import Menu from '../components/Menu.svelte';
import { fetchSite } from '../lib/cms';
import { siteSettings as fallbackSite } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  currentPath?: string;
  header?: boolean;
  footer?: boolean;
}

const {
  title = 'Rakhis de Yudha // Personal archive',
  description = 'A personal archive of work, projects, notes, and what is happening now.',
  currentPath = '/',
  header = true,
  footer = true,
} = Astro.props;

// Live footer identity when the CMS answers; otherwise the intentional
// static fallback. `liveSite === null` also covers CMS-unreachable,
// so the layout never invents CMS data.
const liveSite = await fetchSite();
const footerName = liveSite?.footer_name ?? fallbackSite.footer_name;
const footerLabel = liveSite?.footer_label ?? fallbackSite.footer_label;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <slot name="head" />
    <ClientRouter />
  </head>
  <body>
    {header && <Menu client:load currentPath={currentPath} />}
    <slot />
    {footer && (
      <footer class="site-footer">
        <span>{footerName}</span>
        <span>{footerLabel} <b>◆</b></span>
      </footer>
    )}
    <style is:global>
      /* Persona 5-style route swap: the outgoing page is sheared off
         along a hard diagonal cut, then the incoming page wipes in from
         the right along the matching cut. No fade, no rise — the current
         composition is replaced by the next one like a panel transformation.
         Timing stays in the 300–500ms band: exit 0.34s, enter 0.4s. The
         ~12% slope echoes the site's skewX(-30deg) stripes and the menu
         scene's diagonal panels. */
      ::view-transition-old(root) {
        animation: page-wipe-out 0.34s cubic-bezier(0.76, 0, 0.24, 1) both;
      }
      ::view-transition-new(root) {
        animation: page-wipe-in 0.4s cubic-bezier(0.76, 0, 0.24, 1) 0.12s both;
      }
      /* Outgoing page's diagonal cut travels from right to left, carving
         the surface away. The clip top edge sits above its bottom edge by
         12% of the viewport, giving the wipe a sharp angular feel. */
      @keyframes page-wipe-out {
        from { clip-path: polygon(0 0, 100% 0, 100% 100%, 0 100%); }
        to   { clip-path: polygon(0 0, 12% 0, 0 100%, 0 100%); }
      }
      /* Incoming page's diagonal edge travels from right to left across
         the viewport, revealing the new composition beneath. */
      @keyframes page-wipe-in {
        from { clip-path: polygon(100% 0, 112% 0, 112% 100%, 100% 100%); }
        to   { clip-path: polygon(0 0, 112% 0, 112% 100%, 0 100%); }
      }

      @media (prefers-reduced-motion: reduce) {
        ::view-transition-old(root),
        ::view-transition-new(root) { animation: none; }
      }
    </style>
  </body>
</html>
