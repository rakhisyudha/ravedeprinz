# Copy to .env for local development. Never commit real secrets.
# docker compose loads this file via `env_file:` for the api container,
# so every variable here is visible to the container at runtime.
PORT=4100
# Inside Docker the API reaches Postgres via the `db` service on port
# 5432. Bare-metal dev reaches it via 127.0.0.1:5433 (the published port).
DATABASE_URL=postgres://archive:archive@db:5432/ravedeprinz
# Comma-separated CORS allowlist. Local dev covers both Astro ports;
# production sets exactly one https origin (e.g. FRONTEND_URL=https://ravedeprinz.me).
FRONTEND_URL=http://localhost:3000,http://localhost:3100
UPLOADS_DIR=/data/uploads

# Owner account provisioned by `bun src/seed-auth.ts` on container boot.
# The password is hashed with Bun.password before storage and never logged.
# Both vars must be set before the first api boot; the seed is idempotent
# so re-running with the same email will not duplicate or overwrite.
AUTH_SEED_EMAIL=owner@example.com
AUTH_SEED_PASSWORD=change-me-before-seeding
