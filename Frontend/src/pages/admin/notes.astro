---
import Admin from '../../layouts/Admin.astro';
import AdminNotes from '../../components/admin/AdminNotes.svelte';

export const prerender = false;

const apiBase = (
  import.meta.env.PUBLIC_CMS_API_URL ?? 'http://localhost:4100'
).replace(/\/$/, '');
---
<Admin title="CONTROL — NOTES" currentPath="/admin/notes">
  <AdminNotes client:load apiBase={apiBase} />
</Admin>
