---
import Admin from '../../layouts/Admin.astro';
import AdminDashboard from '../../components/admin/AdminDashboard.svelte';

export const prerender = false;

const apiBase = (
  import.meta.env.PUBLIC_CMS_API_URL ?? 'http://localhost:4100'
).replace(/\/$/, '');
---
<Admin title="CONTROL" currentPath="/admin">
  <AdminDashboard client:load apiBase={apiBase} />
</Admin>
