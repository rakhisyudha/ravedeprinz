# Copy to .env for local development. No secrets in this project.
PUBLIC_CMS_API_URL=http://localhost:4100
CMS_API_URL=http://localhost:4100
SITE_URL=http://localhost:3000
PUBLIC_SITE_URL=http://localhost:3000
# Production overrides (build args / environment, never commit values):
# PUBLIC_CMS_API_URL=https://ravedeprinz.me
# CMS_API_URL=http://api:4100
# SITE_URL=https://ravedeprinz.me
# PUBLIC_SITE_URL=https://ravedeprinz.me

# Optional cookieless analytics. Leave all three empty to disable it.
# PUBLIC_ANALYTICS_PROVIDER accepts exactly one of: plausible, umami, goatcounter
# (case-sensitive; anything else, including "Plausible", renders no snippet).
PUBLIC_ANALYTICS_PROVIDER=
# Absolute https: URL of the provider script. http:// and relative paths
# render no snippet.
PUBLIC_ANALYTICS_SCRIPT_URL=
# Site id. For goatcounter this may be a bare counter name (the snippet
# becomes https://<id>.goatcounter.com/count) or a full https: URL.
PUBLIC_ANALYTICS_SITE_ID=
# Plausible only: every page view is sent by this site's own dispatcher, so
# point PUBLIC_ANALYTICS_SCRIPT_URL at the manual page-view variant
# (script.manual.js on the legacy script, or autoCapturePageviews: false on
# the current one). The default script would also count history navigations
# and double every view.
