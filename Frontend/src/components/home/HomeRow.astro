---
// The one row template for the home page's home-preview lists. Featured Work,
// Latest Notes, and the Now line all render through it, so a row looks and
// behaves identically wherever it appears: media, then a fixed-width date
// column so every row's text starts at the same x, then the copy, then the
// arrow. Only the data fed in differs.

import NoteTags from '../NoteTags.astro';

interface Props {
  href: string;
  /** Artwork, or null for the hatched placeholder. */
  media?: string | null;
  /** Hide the media cell entirely (used by the Now line, which has no art). */
  showMedia?: boolean;
  mediaAlt?: string;
  /** Year for a project, date label for a note, "since" stamp for the now line. */
  date: string;
  title: string;
  /** Status (a project). Omitted where a badge would be noise. */
  badge?: string;
  /** A note's tags, up to three, shown in the badge slot as one wrapping line. */
  tags?: string[];
  /** Standfirst under the title, above the description. Omitted where the entry has none. */
  subtitle?: string | null;
  description?: string;
  /** Accessible name; defaults to the title. */
  ariaLabel?: string;
  /** Clamp the description to one line. Off where the text must show in full. */
  clamp?: boolean;
}

const {
  href,
  media = null,
  showMedia = true,
  mediaAlt = '',
  date,
  title,
  badge = '',
  tags = [],
  subtitle = '',
  description = '',
  ariaLabel,
  clamp = true,
} = Astro.props;
---

<li class="home-row-item">
  <a
    class:list={['home-row', 'row-hover', { 'home-row--no-media': !showMedia }]}
    href={href}
    aria-label={ariaLabel}
  >
    {showMedia && (
      <span class:list={['row-media', { 'is-placeholder': !media }]}>
        {media && <img src={media} alt={mediaAlt} loading="lazy" data-hide-on-error />}
      </span>
    )}
    <span class="row-date">{date}</span>
    <span class="row-copy">
      <span class="row-head">
        <b class="row-title">{title}</b>
        {badge && <span class="row-badge">{badge}</span>}
        {tags.length > 0 && <span class="row-badge"><NoteTags tags={tags} /></span>}
      </span>
      <span class="row-body">
        {subtitle && (
          <span class:list={['row-subtitle', { 'line-clamp-1': clamp }]}>{subtitle}</span>
        )}
        {description && (
          <span class:list={['row-desc', { 'line-clamp-1': clamp }]}>{description}</span>
        )}
      </span>
    </span>
    <span class="row-arrow" aria-hidden="true">↗</span>
  </a>
</li>

{/*
  A media cell whose image fails to load degrades to the same hatched
  placeholder an entry with no artwork gets, rather than removing the cell —
  removing it would collapse the grid and break the row's alignment. Capture
  phase, so it runs on first load and after every ClientRouter swap.
*/}
<script>
  document.addEventListener(
    'error',
    (event) => {
      const target = event.target;
      if (!(target instanceof HTMLImageElement) || !target.hasAttribute('data-hide-on-error')) return;
      const cell = target.closest('.row-media');
      if (!cell) return;
      cell.classList.add('is-placeholder');
      target.remove();
    },
    true,
  );
</script>

<style>
  .home-row-item { list-style:none; }
  /* Column order: [ thumbnail ] [ date ] [ title + tags/status ] [ arrow ].
     The date track is `auto` so it can never be narrower than the text inside
     it — an undersized fixed track is what let a long date spill over the
     title. `.row-date`'s min-width is what aligns the short dates ("11 SEP")
     to the same x as the long ones ("27 AUG 2026") across every row. */
  /* `--card-pad-y` is this link's own block padding, published so the shared
     red accent in global.css can trace the CONTENT box. `top`/`bottom` on an
     absolutely positioned pseudo-element resolve against the padding box, so
     without this the bar runs the full link — 14px above the thumbnail and
     14px below the last line — instead of the visible card. */
  .home-row { --card-pad-y:14px; position:relative; display:grid; grid-template-columns:112px auto minmax(0,1fr) 34px; gap:16px; align-items:center; padding:var(--card-pad-y) 0; border-top:1px solid var(--line-16); text-decoration:none; color:inherit; }
  /* No media cell: three tracks for three children, so the date does not
     inherit the thumbnail's width. */
  .home-row--no-media { grid-template-columns:auto minmax(0,1fr) 34px; }

  /* Media cell is always present in a list row, so the date column below it
     starts at the same x on every row. */
  .row-media { position:relative; display:block; width:112px; height:72px; overflow:hidden; border:1px solid var(--line-18); background:var(--surface); }
  .row-media img { display:block; width:100%; height:100%; object-fit:cover; }
  /* No artwork, or artwork that failed: a hatched plate with the site's red
     slash, so the cell reads as a deliberate placeholder, not a gap. */
  .row-media.is-placeholder {
    background-image:repeating-linear-gradient(-30deg,var(--line-16) 0 2px,transparent 2px 9px);
    background-color:var(--surface-deep);
    border-color:var(--line-25);
  }
  .row-media.is-placeholder::after {
    content:'//'; position:absolute; inset:0; display:grid; place-items:center;
    color:var(--red); font:700 20px var(--font-ui); letter-spacing:2px;
  }

  /* Wide enough for the longest date the site renders ("27 AUG 2026") at the
     30px numeral size, so it never wraps and never needs truncating. */
  .row-date { min-width:176px; color:var(--text-faint); font:var(--type-numeral) var(--font-display); white-space:nowrap; }

  .row-copy { display:flex; flex-direction:column; gap:6px; min-width:0; }
  /* The secondary lines travel as one block so the mobile layout can place
     them in a single grid row. Carries the same 6px gap `.row-copy` uses, so
     above the breakpoint the two render exactly as they did unwrapped. */
  .row-body { display:flex; flex-direction:column; gap:6px; min-width:0; }
  .row-head { display:flex; flex-wrap:wrap; gap:10px; align-items:baseline; min-width:0; }
  .row-title { font:700 var(--type-body) var(--font-ui); letter-spacing:.5px; overflow-wrap:anywhere; }
  .row-badge { color:var(--red); font:700 var(--type-label) var(--font-ui); letter-spacing:2px; }
  /* The standfirst and the description are the same kind of line — a small
     muted sentence under the title — so they share one rule and the
     `.line-clamp-1` truncation cannot drift between them. */
  .row-subtitle,
  .row-desc { color:var(--text-muted); font:var(--type-small) var(--font-ui); overflow-wrap:anywhere; }
  /* ~40% over the base --type-body — a further ~17% on top of the previous
     1.2, landing inside the 15-25% band for the bump. Expressed as a ratio of
     the token so it tracks the type scale, and kept well under the mobile
     title's clamp(19px,…,28px) so it never competes with it. */
  .row-arrow { color:var(--text-faint); font:calc(var(--type-body) * 1.4) var(--font-ui); }
  .line-clamp-1 { display:block; overflow:hidden; white-space:nowrap; text-overflow:ellipsis; }

  /* Mobile. One layout for every row, whichever list it came from — Featured
     Work and Latest Notes differ only in which props they pass, never in where
     anything sits:

       1  thumbnail            (full bleed, unchanged)
       2  Title ......... Date  (date right-aligned, on the title's baseline)
       3  Status / Tag          (FINISHED, MEMOIR — left, directly under the title)
       4  Subtitle / Description (full width)
       5  Read time             (Notes only; the lists without one end at 4)

     The subtitle and the description share one grid row as a single
     `.row-body` block. Placed as two separate items they would need one row
     each, and the list that has only one of them — Featured Work has no
     subtitle, the Now line has neither — would be left holding an empty row
     and a gap that reads as a mistake. One block, one row, no phantom rows.

     The date must share the title's line, but on desktop it is a sibling of
     `.row-copy` while the title is two levels inside it. Flattening the two
     wrappers (`display:contents`) lets every line be placed on the row's own
     grid with nothing moved in the markup, so the desktop column order — and
     every assertion about it — is untouched.

     The arrow is pinned to the row's bottom-right corner instead of taking a
     row of its own, which is what left it stranded below the copy with nothing
     to align to. `.home-row`'s `position:relative` above is what makes that
     anchor real, and `.row-body` reserves the arrow's gutter so the last line
     never runs under it. */
  @media (max-width: 480px) {
    /* At this width the row is a standalone card, not one line in a ruled
       list, so the connecting hairline gives way to a gap. The 5px offset
       global.css puts behind every `.row-hover` row needs room of its own, so
       the gap is larger than the offset: 20px gives the layer somewhere to
       land instead of leaving it touching the next card. */
    .home-row-item { margin-bottom:20px; }
    .home-row { border-top:0; }

    .home-row,
    .home-row--no-media { grid-template-columns:minmax(0,1fr) auto; gap:10px 14px; align-items:baseline; }
    .row-copy,
    .row-head { display:contents; }

    /* Thumbnail, unchanged: still the full-bleed 16:9 plate on top. */
    .row-media { grid-row:1; grid-column:1 / -1; width:100%; height:auto; aspect-ratio:16/9; }

    .row-title { grid-row:2; grid-column:1; min-width:0; color:var(--text); font:700 clamp(19px,5.2vw,28px)/1.05 var(--font-display); letter-spacing:0; overflow-wrap:anywhere; }
    /* `padding-right` clears the 3px red bar, which global.css moves to the
       right edge at this width: the date is right-aligned and would otherwise
       run under it. */
    .row-date { grid-row:2; grid-column:2; min-width:0; text-align:right; font:700 var(--type-label) var(--font-ui); letter-spacing:2px; padding-right:6px; }
    .row-badge { grid-row:3; grid-column:1; text-align:left; }

    /* Inset from both the right and bottom edges, so the glyph never touches the
       card boundary. 38px clears the larger arrow (≈24px wide, sitting 6px
       in) and keeps the last line of copy clear of it. */
    .row-body { grid-row:4; grid-column:1 / -1; padding-right:38px; }

    /* The Now row has no media cell and no badge, so its stack starts at the
       top rather than holding two empty rows above the label. */
    .home-row--no-media .row-title,
    .home-row--no-media .row-date { grid-row:1; }
    .home-row--no-media .row-body { grid-row:2; }

    /* Bottom-right corner of the row, anchored to `.home-row`, held clear of both
       the right edge and the red bar on it. */
    .row-arrow { position:absolute; right:6px; bottom:6px; grid-row:auto; grid-column:auto; }

    .line-clamp-1 { white-space:normal; overflow-wrap:anywhere; }
  }
</style>
