---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import Menu from '../components/Menu.svelte';
import { fetchSite } from '../lib/cms';
import { siteSettings as fallbackSite } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  currentPath?: string;
  chrome?: boolean;
}

const {
  title = 'Rakhis de Yudha // Personal archive',
  description = 'A personal archive of work, projects, notes, and what is happening now.',
  currentPath = '/',
  chrome = true,
} = Astro.props;

// Live footer identity when the CMS answers; otherwise the intentional
// static fallback. `liveSite === null` also covers CMS-unreachable,
// so the layout never invents CMS data.
const liveSite = await fetchSite();
const footerName = liveSite?.footer_name ?? fallbackSite.footer_name;
const footerLabel = liveSite?.footer_label ?? fallbackSite.footer_label;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <ClientRouter />
  </head>
  <body>
    {chrome && <Menu client:load currentPath={currentPath} />}
    <slot />
    {chrome && (
      <footer class="site-footer">
        <span>{footerName}</span>
        <span>{footerLabel} <b>◆</b></span>
      </footer>
    )}
    <style>
      /* Route choreography (mirrors the previous AnimatePresence exit/enter):
         old page slides out first, new page slides in after. */
      ::view-transition-old(root) { animation: page-exit 0.32s ease-out both; }
      ::view-transition-new(root) { animation: page-enter 0.32s ease-out 0.32s both; }
      @keyframes page-exit { to { opacity: 0; transform: translateY(-18px); } }
      @keyframes page-enter { from { opacity: 0; transform: translateY(18px); } }

      /* Page-head entrance (was framer x:-35 in Page.tsx). */
      .page-head { animation: page-head-in 0.45s cubic-bezier(0.22, 1, 0.36, 1) both; }
      @keyframes page-head-in { from { opacity: 0; transform: translateX(-35px); } }

      @media (prefers-reduced-motion: reduce) {
        ::view-transition-old(root),
        ::view-transition-new(root) { animation: none; }
        .page-head { animation: none; }
      }
    </style>
  </body>
</html>
