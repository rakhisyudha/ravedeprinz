---
import Admin from '../../layouts/Admin.astro';
import AdminWork from '../../components/admin/AdminWork.svelte';

export const prerender = false;

const apiBase = (
  import.meta.env.PUBLIC_CMS_API_URL ?? 'http://localhost:4100'
).replace(/\/$/, '');
---
<Admin title="CONTROL — WORK" currentPath="/admin/work">
  <AdminWork client:load apiBase={apiBase} />
</Admin>
