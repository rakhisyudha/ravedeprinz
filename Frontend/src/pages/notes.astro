---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { fetchNotes, type Note } from '../lib/cms';
import { fallbackNoteList } from '../lib/fallback';
import NoteTagFilter from '../components/NoteTagFilter.astro';
import NoteTags from '../components/NoteTags.astro';
import { noteDateLabel, noteSlug, readLabel } from '../lib/notesPreview';
import { facetChips, filterNotesByTags, noteTagList, parseTagParams } from '../lib/noteTags';
import { getSiteUrl } from '../lib/seo';

export const prerender = false;

// Live notes when the CMS answers; otherwise the intentional static
// fallback, normalized to the same shape. The strip and this list share
// noteDateLabel/noteSlug/readLabel, so both render identical labels and
// hrefs for the same note.
const liveNotes = await fetchNotes();
const allNotes = liveNotes?.notes ?? fallbackNoteList();

// `?tag=A&tag=B` narrows the list to notes carrying every selected tag. The
// chips are built from the full list, so they stay put while a filter is
// active, and a selection nothing matches is an empty list with a way back
// rather than an error.
const activeTags = parseTagParams(Astro.url.searchParams);
const chips = facetChips(allNotes, activeTags);
const notes = filterNotesByTags(allNotes, activeTags);

// The title is the primary content here; the artwork is an optional
// enhancement. The note has no presentation field expressing that preference,
// so it is derived from the only thing it is really about — how much room the
// title needs at the mobile size. Past this length the display title wants the
// full card width more than the note wants a thumbnail.
//
// This is a rendering decision, not a truncation: the title is always emitted
// in full and simply wraps, and the thumbnail column collapses to match (see
// `.note-link:not(:has(.note-thumb))`). One constant to tune, no new field on
// the model and no new abstraction.
const LONG_TITLE_CHARS = 36;

const showThumbnail = (note: Note) =>
  Boolean(note.image_url) && note.title.trim().length <= LONG_TITLE_CHARS;
---
<Base title="NOTES" currentPath="/notes">
  <Fragment slot="head">
    {/* Every filtered view is a subset of /notes, so the plain list is the one canonical URL. */}
    <link rel="canonical" href={`${getSiteUrl()}/notes`} />
  </Fragment>
  <PageHead index="TRANSMISSIONS / 005" title="NOTES" intro="Short transmissions from the workbench. Mostly unfinished thoughts, left legible on purpose.">
    <NoteTagFilter chips={chips} selectedCount={activeTags.length} total={allNotes.length} />
    {activeTags.length > 0 && notes.length === 0 && (
      <div class="notes-empty">
        <p class="eyebrow">
          {activeTags.length === 1 ? 'NO NOTES TAGGED ' : 'NO NOTES TAGGED WITH ALL OF '}
          {activeTags.map((tag) => `“${tag}”`).join(' + ')}
        </p>
        <a class="bracket-btn row-hover--accent" href="/notes">[ ALL NOTES ]</a>
      </div>
    )}
    <section class="notes-list">
      {notes.map((note) => {
        const slug = noteSlug(note);
        return (
          <article class="note">
            <a href={`/notes/${slug}`} class="note-link lift">
              <span class="note-date">{noteDateLabel(note.created_at, note.published_at)}<small>{readLabel(note)}</small></span>
              <div class="note-body">
                {/* Reading order: tags, author, title, subtitle. Tags are plain
                    text (the whole card is the link) and wrap only between tags. */}
                <p class="eyebrow"><NoteTags tags={noteTagList(note)} /></p>
                {note.author && <p class="note-author">{note.author}</p>}
                <h2>{note.title}</h2>
                <p>{note.subtitle || note.body}</p>
              </div>
          {showThumbnail(note) && (
            <div class="note-thumb">
              <img src={note.image_url} alt="" loading="lazy" />
            </div>
          )}
            </a>
          </article>
        );
      })}
    </section>
  </PageHead>
</Base>

<style>
  /* The author sits on its own line under the tags, at every width, quieter
     than the tags above it. Written against `.note .note-author` because the
     shared `.note p` rule would otherwise set its size and colour. */
  .note .note-author { margin:2px 0 0; max-width:none; color:var(--text-faint); font:var(--type-label) var(--font-ui); letter-spacing:.2em; line-height:1.6; text-transform:uppercase; overflow-wrap:anywhere; }

  .notes-empty { position:relative; z-index:2; max-width:950px; display:flex; flex-direction:column; align-items:flex-start; gap:16px; margin:0 0 28px; }
  .notes-empty p { margin:0; }
</style>
