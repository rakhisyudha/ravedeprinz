{
  "_comment": "Shared edge-case table for the case-study length and order validators. Both Backend/tests/properties/*.test.ts and Frontend/tests/properties/admin-*-validation.test.ts build identical inputs from it, so the two validators are provably in agreement. Case-study fields are described by length (repeated 'a') instead of literal strings to keep the table readable.",
  "caseStudyMax": 10000,
  "sortOrderMin": 0,
  "sortOrderMax": 9999,
  "caseStudy": [
    {
      "label": "all fields empty",
      "lengths": { "problem": 0, "what_built": 0, "key_decision": 0, "outcome": 0 },
      "valid": true,
      "field": null
    },
    {
      "label": "every field exactly at the limit",
      "lengths": { "problem": 10000, "what_built": 10000, "key_decision": 10000, "outcome": 10000 },
      "valid": true,
      "field": null
    },
    {
      "label": "problem one character over the limit",
      "lengths": { "problem": 10001, "what_built": 0, "key_decision": 0, "outcome": 0 },
      "valid": false,
      "field": "problem"
    },
    {
      "label": "what_built one character over the limit",
      "lengths": { "problem": 0, "what_built": 10001, "key_decision": 0, "outcome": 0 },
      "valid": false,
      "field": "what_built"
    },
    {
      "label": "key_decision far over the limit",
      "lengths": { "problem": 0, "what_built": 0, "key_decision": 12000, "outcome": 0 },
      "valid": false,
      "field": "key_decision"
    },
    {
      "label": "outcome one character under the limit",
      "lengths": { "problem": 0, "what_built": 0, "key_decision": 0, "outcome": 9999 },
      "valid": true,
      "field": null
    },
    {
      "label": "two fields over the limit reports the first one",
      "lengths": { "problem": 10001, "what_built": 10001, "key_decision": 10001, "outcome": 10001 },
      "valid": false,
      "field": "problem"
    },
    {
      "label": "only what_built over the limit while key_decision and outcome are also over",
      "lengths": { "problem": 0, "what_built": 10001, "key_decision": 10001, "outcome": 10001 },
      "valid": false,
      "field": "what_built"
    },
    {
      "label": "problem within the limit while later fields are over",
      "lengths": { "problem": 10000, "what_built": 0, "key_decision": 10001, "outcome": 10001 },
      "valid": false,
      "field": "key_decision"
    },
    {
      "label": "problem and what_built within the limit while outcome is over",
      "lengths": { "problem": 10000, "what_built": 10000, "key_decision": 0, "outcome": 12000 },
      "valid": false,
      "field": "outcome"
    }
  ],
  "order": [
    { "label": "lower bound as a number", "value": 0, "valid": true },
    { "label": "upper bound as a number", "value": 9999, "valid": true },
    { "label": "middle of the range", "value": 42, "valid": true },
    { "label": "upper bound as a float with no fraction", "value": 9999.0, "valid": true },
    { "label": "digits as a string", "value": "12", "valid": true },
    { "label": "digits as a padded string", "value": " 12 ", "valid": true },
    { "label": "zero as a string", "value": "0", "valid": true },
    { "label": "upper bound as a string", "value": "9999", "valid": true },
    { "label": "one over the upper bound", "value": 10000, "valid": false },
    { "label": "far over the upper bound", "value": 123456, "valid": false },
    { "label": "negative number", "value": -1, "valid": false },
    { "label": "fractional number", "value": 1.5, "valid": false },
    { "label": "empty string", "value": "", "valid": false },
    { "label": "whitespace-only string", "value": "   ", "valid": false },
    { "label": "non-numeric string", "value": "abc", "valid": false },
    { "label": "mixed string", "value": "12a", "valid": false },
    { "label": "signed string", "value": "+12", "valid": false },
    { "label": "exponent string", "value": "1e3", "valid": false },
    { "label": "decimal string", "value": "1.5", "valid": false },
    { "label": "over the upper bound as a string", "value": "10000", "valid": false },
    { "label": "negative string", "value": "-1", "valid": false },
    { "label": "null", "value": null, "valid": false },
    { "label": "boolean", "value": true, "valid": false },
    { "label": "object", "value": {}, "valid": false }
  ],
  "noteTagsMin": 1,
  "noteTagsMax": 3,
  "noteTagMaxLength": 16,
  "noteTags": [
    { "label": "one tag, normalized", "body": { "tags": ["reflection"] }, "valid": true, "tags": ["REFLECTION"] },
    { "label": "three tags keep their order", "body": { "tags": ["memoir", "Log", "reflection"] }, "valid": true, "tags": ["MEMOIR", "LOG", "REFLECTION"] },
    { "label": "inner whitespace collapses and ends trim", "body": { "tags": ["  dev   log "] }, "valid": true, "tags": ["DEV LOG"] },
    { "label": "blank entries are dropped", "body": { "tags": ["a", "", "   ", "b"] }, "valid": true, "tags": ["A", "B"] },
    { "label": "repeats collapse to the first spelling", "body": { "tags": ["log", "LOG", " Log "] }, "valid": true, "tags": ["LOG"] },
    { "label": "four tags where repeats bring it down to three", "body": { "tags": ["a", "b", "A", "c"] }, "valid": true, "tags": ["A", "B", "C"] },
    { "label": "exactly sixteen characters", "body": { "tags": ["abcdefghijklmnop"] }, "valid": true, "tags": ["ABCDEFGHIJKLMNOP"] },
    { "label": "legacy single tag", "body": { "tag": "reflection" }, "valid": true, "tags": ["REFLECTION"] },
    { "label": "tags win over the legacy tag", "body": { "tags": ["a"], "tag": "zzz" }, "valid": true, "tags": ["A"] },
    { "label": "four distinct tags", "body": { "tags": ["a", "b", "c", "d"] }, "valid": false, "field": "tags" },
    { "label": "an empty list", "body": { "tags": [] }, "valid": false, "field": "tags" },
    { "label": "only blank entries", "body": { "tags": ["", "  "] }, "valid": false, "field": "tags" },
    { "label": "seventeen characters", "body": { "tags": ["abcdefghijklmnopq"] }, "valid": false, "field": "tags" },
    { "label": "a comma inside a tag", "body": { "tags": ["a,b"] }, "valid": false, "field": "tags" },
    { "label": "a control character inside a tag", "body": { "tags": ["a\u0007b"] }, "valid": false, "field": "tags" },
    { "label": "legacy tag with a comma", "body": { "tag": "a,b" }, "valid": false, "field": "tags" },
    { "label": "legacy tag that is blank", "body": { "tag": "   " }, "valid": false, "field": "tags" },
    { "label": "tags that is not a list", "body": { "tags": "a" }, "valid": false, "field": "tags" },
    { "label": "null tags", "body": { "tags": null }, "valid": false, "field": "tags" },
    { "label": "an entry that is not text", "body": { "tags": [1] }, "valid": false, "field": "tags" },
    { "label": "an object entry", "body": { "tags": [{}] }, "valid": false, "field": "tags" }
  ]
}
