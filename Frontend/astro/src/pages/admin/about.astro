---
import Admin from '../../layouts/Admin.astro';
import AdminAbout from '../../components/admin/AdminAbout.svelte';

export const prerender = false;

const apiBase = (
  import.meta.env.PUBLIC_CMS_API_URL ?? 'http://localhost:4100'
).replace(/\/$/, '');
---
<Admin title="CONTROL — ABOUT" currentPath="/admin/about">
  <AdminAbout client:load apiBase={apiBase} />
</Admin>
